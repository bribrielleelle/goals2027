modules = ["bun-1.3", "nodejs-24", "postgresql-16"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bun run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "cloudrun"

[deployment.run]
args = ["sh", "-c", "/nix/store/2lphmxmxhz186wgpya8vlj3z3za48zld-package-json-runner/bin/package-json-runner --run-script /nix/store/4lj4hwbvr5w3w9m2bqfflbsnvij5fjmi-bun-1.3.6-wrapped/bin/bun --run-package-json-script /nix/store/4lj4hwbvr5w3w9m2bqfflbsnvij5fjmi-bun-1.3.6-wrapped/bin/bun run"]
